{
	"name": "konashevich-pdf-viewer",
	"displayName": "PDF Viewer (Page Scroll)",
	"description": "PDF viewer based on PDF.js with page-by-page scrolling, Page Fit by default, a Dual Page Mode action, and printing through the system print dialog.",
	"version": "1.0.2",
	"publisher": "oleksiiko",
	"repository": {
		"type": "git",
		"url": "https://github.com/konashevich/konashevich-pdf-viewer.git"
	},
	"bugs": {
		"url": "https://github.com/konashevich/konashevich-pdf-viewer/issues"
	},
	"homepage": "https://github.com/konashevich/konashevich-pdf-viewer#readme",
	"engines": {
		"vscode": "^1.96.0"
	},
	"icon": "icon.png",
	"license": "Apache-2.0",
	"keywords": [
		"pdf",
		"viewer",
		"pdf.js",
		"page scroll",
		"dual page",
		"print"
	],
	"categories": [
		"Visualization",
		"Other"
	],
	"main": "./dist/extension.js",
	"activationEvents": [
		"onCustomEditor:konashevich.pdf.view"
	],
	"contributes": {
		"customEditors": [
			{
				"viewType": "konashevich.pdf.view",
				"displayName": "PDF Viewer (Page Scroll)",
				"selector": [
					{
						"filenamePattern": "*.pdf"
					}
				]
			}
		],
		"configuration": {
			"type": "object",
			"title": "PDF Viewer (Page Scroll)",
			"properties": {
				"acaciaPdf.scrollMode": {
					"type": "string",
					"default": "page",
					"enum": [
						"vertical",
						"horizontal",
						"wrapped",
						"page"
					],
					"enumDescriptions": [
						"Continuous vertical scrolling",
						"Continuous horizontal scrolling",
						"Wrapped scrolling",
						"Page-by-page scrolling (discrete pages)"
					],
					"description": "Default scroll mode for the PDF viewer."
				}
			}
		}
	},
	"scripts": {
		"package": "vsce package --no-dependencies",
		"publish:vsce": "vsce publish --no-dependencies",
		"publish:ovsx": "ovsx publish --no-dependencies"
	}
}
